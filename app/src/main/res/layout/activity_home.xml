<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity"
    android:background="@color/background">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bgnavbar"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"/>
    
    <LinearLayout
        android:id="@+id/LinearLayoutProfile"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:layout_margin="40dp"
        tools:layout_editor_absoluteY="34dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="67dp"
            android:layout_height="70dp"
            android:src="@drawable/profile2"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="15dp">
            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textColor="@color/white"
                tools:layout_editor_absoluteX="120dp"
                tools:layout_editor_absoluteY="46dp" />

            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fabian Varel"
                android:textColor="@color/white"
                android:textSize="20dp"
                android:fontFamily="sans-serif-black"
                app:layout_constraintTop_toBottomOf="@id/textView"
                tools:layout_editor_absoluteX="120dp"
                tools:layout_editor_absoluteY="77dp" />

        </LinearLayout>
    </LinearLayout>

    <ViewFlipper
        android:id="@+id/carouser"
        android:layout_width="318dp"
        android:layout_height="180dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="-20dp"
        app:layout_constraintTop_toBottomOf="@id/LinearLayoutProfile">

    </ViewFlipper>

    <ImageView
        android:id="@+id/btnLeft"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="60dp"
        android:src="@drawable/prev"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.290"/>

    <ImageView
        android:id="@+id/btnRight"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="60dp"

        android:src="@drawable/next"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.290" />

    <ScrollView
        android:layout_width="318dp"
        android:layout_height="280dp"
        app:layout_constraintTop_toBottomOf="@id/carouser"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/logo_market"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Explore Items"
                    android:textSize="20dp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Discover our curated selection of
                ceremonial grade matcha and tools."
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="View Catalog ->"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/button"
                    android:layout_marginTop="10dp"
                    android:id="@+id/btn_to_market"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/logo_branch"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Our Branches"
                    android:textSize="20dp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find the nearest Chi Matcha sanctuary
                    to experience the ritual in person."
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find Location ->"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/button"
                    android:id="@+id/btn_to_branch"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_marginTop="20dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/logo_logout"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Log Out"
                    android:textSize="20dp"
                    android:fontFamily="sans-serif-black"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Take a break from your digital journey.
                    We'll be here when you return."
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sign Out of Account"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/red"
                    android:id="@+id/btn_logout"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rectangle_rounded"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_margin="20dp"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btn_menu_home"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/homelogo"
            android:layout_marginHorizontal="40dp"
            android:contentDescription="Home Button"/>

        <ImageButton
            android:id="@+id/btn_menu_market"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/market"
            android:layout_marginHorizontal="40dp"
            android:contentDescription="Market Button"/>

        <ImageButton
            android:id="@+id/btn_menu_branch"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/branchlogo"
            android:layout_marginHorizontal="40dp"
            android:contentDescription="Branch Button"/>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>